# Copy to `.env.local` — never commit `.env.local`

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_V1_PREFIX=/api/v1

# NextAuth — must match AUTH_SECRET in root `.env`
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-nextauth-secret-at-least-32-chars
AUTH_URL=http://localhost:3000
