# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# ── Secrets & environment (NEVER commit real keys) ────────────────────────────
.env
.env.local
.env.*.local
apps/api/.env
apps/web/.env.local

# azd writes subscription ids and secret values here. Keep .azure/config.json.
.azure/**/.env
.azure/**/.env.*
*.pem
*.key
credentials.json
service-account*.json
secrets/

# Keep example env files (placeholders only)
!.env.example
!apps/web/.env.example

# ── Local databases & tooling (machine-specific) ─────────────────────────────
/data/
/tools/

# ── User uploads & generated files ───────────────────────────────────────────
apps/api/uploads/
uploads/

# ── IDE & OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
.cursor/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Next.js ───────────────────────────────────────────────────────────────────
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts

# ── Python testing & coverage ─────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.cover

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Alembic ───────────────────────────────────────────────────────────────────
apps/api/alembic/versions/*.pyc
