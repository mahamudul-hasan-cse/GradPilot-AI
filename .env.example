# ─── Application ───────────────────────────────────────────────
APP_NAME=GradPilot AI
APP_ENV=development
DEBUG=true

# ─── API ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ──────────────────────────────────────────────────
POSTGRES_USER=gradpilot
POSTGRES_PASSWORD=gradpilot_secret
POSTGRES_DB=gradpilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gradpilot:gradpilot_secret@postgres:5432/gradpilot
DATABASE_URL_SYNC=postgresql+psycopg2://gradpilot:gradpilot_secret@postgres:5432/gradpilot

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ─── Qdrant ────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=gradpilot_embeddings
EMBEDDING_MODEL=text-embedding-3-small

# ─── Ingestion Pipeline ────────────────────────────────────────
INGESTION_USER_AGENT=GradPilotBot/1.0 (+https://gradpilot.ai/bot)
INGESTION_CONCURRENCY=10
INGESTION_RATE_LIMIT_PER_DOMAIN=1.0
INGESTION_TIMEOUT_SECONDS=30
INGESTION_BATCH_SIZE=50
INGESTION_FULL_BATCH_SIZE=200
INGESTION_RESPECT_ROBOTS=true
INGESTION_INCREMENTAL_CRON=0 */6 * * *
INGESTION_FULL_CRON=0 2 * * 0

# ─── Redis (Recommendation Cache) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_ENABLED=true
RECOMMENDATION_CACHE_TTL_SECONDS=3600

# ─── LLM (AI Knowledge Platform) ─────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3
KNOWLEDGE_MEMORY_TTL_SECONDS=86400

# ─── Document Intelligence ─────────────────────────────────────
DOCUMENT_UPLOAD_DIR=uploads
DOCUMENT_OCR_PROVIDER=fallback

# ─── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_V1_PREFIX=/api/v1
