# GradPilot — copy this file to `.env` at the repo root and fill in real values.
# NEVER commit `.env` or paste API keys into source code.

# PostgreSQL (local or Neon). asyncpg driver is used by FastAPI.
DATABASE_URL=postgresql+asyncpg://gradpilot:YOUR_PASSWORD@localhost:5432/gradpilot

# App security — generate long random strings for non-local use
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-jwt-secret-at-least-32-characters
AUTH_SECRET=replace-with-a-nextauth-secret-at-least-32-chars

# Generative AI — set OpenRouter (preferred) or Gemini. At least one is required in production.
# OpenRouter (preferred when set — OpenAI-compatible chat completions)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Gemini (used when OPENROUTER_API_KEY is not set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Runtime
UPLOAD_DIR=uploads
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (also copy apps/web/.env.example → apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_V1_PREFIX=/api/v1
