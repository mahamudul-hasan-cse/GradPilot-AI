{
  "name": "gradpilot-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build:web": "npm run build --workspace=web",
    "lint:web": "npm run lint --workspace=web"
  },
  "engines": {
    "node": ">=20"
  }
}
